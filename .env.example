# v0.2 — Speaker Diarization
APP_ENV=development
MAX_AUDIO_SIZE_MB=500
STORAGE_PATH=./backend/data
DATABASE_URL=sqlite:///./backend/data/app.db

# Transcription: "fake" (default, no model download, deterministic — good for dev/tests)
# or "whisper" (requires `pip install faster-whisper` and model download)
TRANSCRIPTION_PROVIDER=fake
TRANSCRIPTION_MODEL=tiny

# v0.2 — Speaker Diarization
# Enable/disable diarization after transcription
DIARIZATION_ENABLED=false
# Diarization provider: "fake" (default, deterministic) or "pyannote" (requires pyannote.audio)
DIARIZATION_PROVIDER=fake

# v0.3 — Semantic Analysis
# Enable/disable semantic analysis after transcription
SEMANTIC_ANALYSIS_ENABLED=false
# Semantic analysis provider: "fake" (default, deterministic) or "llm" (requires openai package + API key)
SEMANTIC_ANALYSIS_PROVIDER=fake
# LLM settings (only needed when SEMANTIC_ANALYSIS_PROVIDER=llm)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...  # Never commit this. Set via environment variable.

# CORS origins for local frontend dev (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
